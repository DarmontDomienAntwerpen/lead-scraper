# Anthropic API key voor de Claude-calls (analyze + write nodes)
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API key (Places API New of legacy, text search + place details)
GOOGLE_PLACES_API_KEY=AIza...

# Optioneel: NeverBounce key voor e-mailverificatie (single check API).
# Zonder key wordt verificatie overgeslagen, gevonden e-mails blijven dan ongeverifieerd.
NEVERBOUNCE_API_KEY=
