# Anthropic API key for the Claude calls (analyze + write nodes)
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API key (Places API, text search + place details)
GOOGLE_PLACES_API_KEY=AIza...

# Optional: NeverBounce key for email verification (single check API).
# Without a key, verification is skipped and found addresses stay unverified.
NEVERBOUNCE_API_KEY=
